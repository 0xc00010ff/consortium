# Consortium calls models through the Vercel AI Gateway, through each
# maker's own API, or through Claude Code and Codex when they are installed
# on this machine. Keys saved in Settings (~/.consortium/settings.json) win
# over the ones here. Copy this file to .env.local to set keys here instead.
# Without any key, the app uses Claude Code or Codex if either is installed,
# and otherwise runs in mock mode with sample replies.

# One gateway key runs every model and enables web search.
AI_GATEWAY_API_KEY=

# Without a gateway key, each of these runs that maker's models directly.
# Web search needs the gateway key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY also works for Google.
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# The folder for settings.json. Defaults to ~/.consortium.
CONSORTIUM_HOME=

# Set to 1 to use sample replies even when a key is set.
CONSORTIUM_MOCK=

# Speed of the sample replies in mock mode. 1 is the normal pace, 0 removes the delays.
CONSORTIUM_MOCK_DELAY=

# Claude Code and Codex are found on the PATH and in the usual install
# folders. Set these to a full path if a tool is installed somewhere else.
# A path saved in Settings wins over these.
CONSORTIUM_CLAUDE_BIN=
CONSORTIUM_CODEX_BIN=
