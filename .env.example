# Consortium calls models through the Vercel AI Gateway, or through Claude Code
# and Codex when they are installed on this machine.
# Copy this file to .env.local and add your key to use real models.
# Without a key, the app uses Claude Code or Codex if either is installed,
# and otherwise runs in mock mode with sample replies.
AI_GATEWAY_API_KEY=

# Set to 1 to use sample replies even when a key is set.
CONSORTIUM_MOCK=

# Speed of the sample replies in mock mode. 1 is the normal pace, 0 removes the delays.
CONSORTIUM_MOCK_DELAY=

# Claude Code and Codex are found on the PATH and in the usual install
# folders. Set these to a full path if a tool is installed somewhere else.
CONSORTIUM_CLAUDE_BIN=
CONSORTIUM_CODEX_BIN=
